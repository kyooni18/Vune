{
  "name": "rui",
  "version": "1.0.0-alpha.4",
  "packageManager": "pnpm@11.22.0",
  "description": "A SwiftUI-like declarative UI layer for React with optional Vite macros.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./package.json": "./package.json",
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx-dev-runtime.js"
    },
    "./experimental": {
      "types": "./dist/experimental.d.ts",
      "import": "./dist/experimental.js"
    },
    "./compiler": {
      "types": "./dist/compiler/index.d.ts",
      "import": "./dist/compiler/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.build.json --noEmit",
    "test:types": "tsc -p tsconfig.tests.json",
    "test:runtime": "node --test tests/react-runtime.test.mjs tests/react-widgets.test.mjs tests/react-client.test.mjs tests/macro-react.test.mjs tests/new-features.test.mjs",
    "test:browser": "node --test tests/browser.test.mjs",
    "benchmark:modifiers": "pnpm run build && node benchmarks/modifiers.mjs",
    "benchmark:modifiers:ci": "RUI_BENCH_CI=1 RUI_BENCH_MAX_RATIO=50 pnpm run benchmark:modifiers",
    "test": "pnpm run build && pnpm run test:types && pnpm run test:runtime",
    "dev": "vite --config examples/vite.config.ts",
    "demo:build": "vite build --config examples/vite.config.ts",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@playwright/test": "^1.52.0",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^26.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^8.2.1"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "react",
    "typescript",
    "declarative-ui",
    "swiftui",
    "vite",
    "dsl",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyooni18/Rui.git"
  },
  "bugs": {
    "url": "https://github.com/kyooni18/Rui/issues"
  },
  "homepage": "https://github.com/kyooni18/Rui#readme",
  "dependencies": {
    "typescript": "^5.8.3"
  }
}
