{
  "name": "vune",
  "version": "1.0.0-alpha.2",
  "description": "A SwiftUI-like declarative UI layer for React with optional Vite macros.",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md", "LICENSE"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./vite": { "types": "./dist/vite.d.ts", "import": "./dist/vite.js" },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.build.json --noEmit",
    "test:types": "tsc -p tsconfig.tests.json",
    "test:runtime": "node --test tests/react-runtime.test.mjs tests/macro-react.test.mjs",
    "test": "npm run build && npm run test:types && npm run test:runtime",
    "dev": "vite --config examples/vite.config.ts",
    "demo:build": "vite build --config examples/vite.config.ts",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.8.3",
    "vite": "^8.2.1"
  },
  "engines": { "node": ">=20.19.0" },
  "keywords": ["react", "typescript", "declarative-ui", "swiftui", "vite", "dsl", "ui"],
  "repository": { "type": "git", "url": "git+https://github.com/kyooni18/Vune.git" },
  "bugs": { "url": "https://github.com/kyooni18/Vune/issues" },
  "homepage": "https://github.com/kyooni18/Vune#readme"
}
