{
  "name": "vune",
  "version": "0.6.0",
  "description": "A small SwiftUI-like declarative UI layer for Vue that returns real Vue VNodes.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.build.json --noEmit",
    "test:types": "tsc -p tsconfig.tests.json",
    "test:runtime": "node --test tests/core.test.mjs tests/view.test.mjs",
    "test:ssr": "node --test tests/ssr.test.mjs",
    "test": "npm run build && npm run test:types && npm run test:runtime && npm run test:ssr",
    "dev": "vite --config examples/vite.config.ts",
    "demo:build": "vite build --config examples/vite.config.ts",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "vue": ">=3.3.0 <4"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vue": "^3.5.41",
    "@vitejs/plugin-vue": "^6.0.8",
    "vite": "^8.2.1"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "vue",
    "typescript",
    "declarative-ui",
    "render-function",
    "dsl",
    "ui",
    "vnode"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyooni18/Vune.git"
  },
  "bugs": {
    "url": "https://github.com/kyooni18/Vune/issues"
  },
  "homepage": "https://github.com/kyooni18/Vune#readme"
}
