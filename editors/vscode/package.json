{
  "name": "vune-language-support",
  "displayName": "Vune Language Support",
  "description": "Vune and raw HTML syntax and semantic highlighting, diagnostics, formatting, completion, hover, signature help, and language tooling.",
  "version": "0.1.0",
  "private": true,
  "publisher": "vune-ui",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:vune", "onLanguage:vue"],
  "main": "./extension.cjs",
  "contributes": {
    "languages": [{
      "id": "vune-ui",
      "aliases": ["Vune", "vune.ts"],
      "extensions": [".vune.ts"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "vune-ui",
      "scopeName": "source.vune",
      "path": "./syntaxes/vune.tmLanguage.json"
    }],
    "commands": [{
      "command": "vune.formatDocument",
      "title": "Vune: Format Document"
    }],
    "configuration": {
      "title": "Vune",
      "properties": {
        "vune.languageTools.enableVue": {
          "type": "boolean",
          "default": true,
          "description": "Enable Vune formatting, completion, hover, signature help, definition, diagnostics, rename, and semantic highlighting in Vue SFCs."
        }
      }
    }
  }
}
