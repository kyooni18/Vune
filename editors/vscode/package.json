{
  "name": "muse-language-support",
  "displayName": "Muse Language Support",
  "description": "Muse and raw HTML syntax highlighting, diagnostics, formatting, completion, hover, signature help, and language tooling.",
  "version": "0.1.0",
  "private": true,
  "publisher": "muse",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:muse", "onLanguage:vue"],
  "main": "./extension.cjs",
  "contributes": {
    "languages": [{
      "id": "muse",
      "aliases": ["Muse", "muse.ts"],
      "extensions": [".muse.ts"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "muse",
      "scopeName": "source.muse",
      "path": "./syntaxes/muse.tmLanguage.json"
    }],
    "commands": [{
      "command": "muse.formatDocument",
      "title": "Muse: Format Document"
    }],
    "configuration": {
      "title": "Muse",
      "properties": {
        "muse.languageTools.enableVue": {
          "type": "boolean",
          "default": true,
          "description": "Enable Muse formatting, completion, hover, signature help, definition, diagnostics, and rename support in Vue SFCs."
        }
      }
    }
  }
}
