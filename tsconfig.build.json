{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "files": [
    "src/index.ts",
    "src/elements.ts",
    "src/layout.ts",
    "src/modifiers.ts",
    "src/state.ts",
    "src/types.ts",
    "src/view.ts",
    "src/vite.ts"
  ]
}
