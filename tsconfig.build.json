{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "files": [
    "src/index.ts",
    "src/compiler/index.ts",
    "src/core.ts",
    "src/experimental.ts",
    "src/muse.ts",
    "src/closures.ts",
    "src/state.ts",
    "src/types.ts",
    "src/react-types.ts",
    "src/vite.ts",
    "src/jsx-runtime.ts",
    "src/jsx-dev-runtime.ts"
  ]
}
