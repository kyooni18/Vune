{
  "name": "@vune-ui/vite",
  "version": "0.1.1",
  "description": "Vite integration for the Vune compiler.",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@vune-ui/compiler": "^0.1.1"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
