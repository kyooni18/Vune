{
  "name": "@vune-ui/vue",
  "version": "0.1.19",
  "description": "Vue renderer and explicit interop bridges for the renderer-independent Vune core.",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "watch": "tsc -w -p tsconfig.json --preserveWatchOutput"
  },
  "dependencies": {
    "@vune-ui/core": "workspace:*"
  },
  "peerDependencies": {
    "vue": ">=3.4 <4"
  },
  "devDependencies": {
    "vue": "^3.5.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
