{
  "name": "@vune-ui/core",
  "version": "0.1.20",
  "description": "Renderer-independent Vune View graph and state primitives.",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./internal/motion-abi": {
      "types": "./dist/motion-abi.d.ts",
      "import": "./dist/motion-abi.js"
    },
    "./internal/runtime": {
      "types": "./dist/internal-runtime.d.ts",
      "import": "./dist/internal-runtime.js"
    },
    "./web-primitives": {
      "types": "./dist/web-primitives.d.ts",
      "import": "./dist/web-primitives.js"
    },
    "./corners": {
      "types": "./dist/corners.d.ts",
      "import": "./dist/corners.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "watch": "tsc -w -p tsconfig.json --preserveWatchOutput"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
