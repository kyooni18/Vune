{
  "name": "@vune-ui/core",
  "version": "0.1.14",
  "description": "Renderer-independent Vune View graph and state primitives.",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "watch": "tsc -w -p tsconfig.json --preserveWatchOutput"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
