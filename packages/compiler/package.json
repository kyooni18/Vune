{
  "name": "@muse/compiler",
  "version": "0.1.0",
  "description": "TypeScript-hosted compiler for Muse builder and .muse.ts syntax.",
  "type": "module",
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "typescript": "^5.8.3"
  }
}
