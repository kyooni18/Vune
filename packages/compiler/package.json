{
  "name": "@vune-ui/compiler",
  "version": "0.1.20",
  "description": "TypeScript-hosted compiler for Vune builder and .vune/.vune.ts syntax.",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "watch": "tsc -w -p tsconfig.json --preserveWatchOutput"
  },
  "dependencies": {
    "@vune-ui/core": "workspace:*",
    "@vune-ui/execution": "workspace:*",
    "typescript": "^5.8.3"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
